#!/usr/bin/env python3
"""gh-review-ui — launcher.

The implementation lives in the ``ghreview`` package next to this file; this
script just makes it importable (even when invoked through a symlink on PATH)
and hands off to ``ghreview.app.main``.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ghreview.app import main

if __name__ == "__main__":
    main()
